.page { padding: 24rpx 24rpx 60rpx; }

.head-tip {
  font-size: 24rpx; color: var(--text-2); line-height: 1.6;
  padding: 4rpx 8rpx 20rpx;
}

.batch { padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.brow { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; margin-bottom: 16rpx; }
.brow:last-child { margin-bottom: 0; }
.pick {
  font-size: 26rpx; color: var(--text);
  background: var(--bg); border-radius: 12rpx; padding: 12rpx 22rpx;
}
.batch-price {
  flex: 1; min-width: 220rpx;
  background: var(--bg); border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 26rpx;
}
.apply {
  font-size: 26rpx; color: #fff; background: var(--brand);
  border-radius: 12rpx; padding: 14rpx 26rpx;
}

.book { padding: 28rpx; margin-bottom: 24rpx; }
.bk-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.bk-idx { font-size: 28rpx; font-weight: 700; color: var(--brand); }
.bk-del { font-size: 24rpx; color: var(--text-3); }

.field { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid var(--border); }
.label { width: 150rpx; flex-shrink: 0; font-size: 26rpx; color: var(--text-2); }
.input { flex: 1; font-size: 28rpx; }

.note-row { display: flex; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid var(--border); }
.chips { flex: 1; display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  font-size: 24rpx; color: var(--text-2);
  background: var(--bg); border-radius: 30rpx; padding: 10rpx 24rpx;
  border: 1rpx solid transparent;
}
.chip.on { background: var(--brand-light); color: var(--brand); border-color: var(--brand); }

.raw {
  font-size: 22rpx; color: var(--text-3); line-height: 1.5;
  background: var(--bg); border-radius: 10rpx; padding: 12rpx 16rpx; margin-top: 12rpx;
}

.pub-btn { margin-top: 16rpx; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 28rpx; color: var(--text-2); margin-top: 24rpx; }
