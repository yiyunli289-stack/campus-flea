<view class="page">
  <view class="card subscription" wx:if="{{subscriptionOptions.length}}">
    <view class="notice-title">微信提醒</view>
    <button wx:for="{{subscriptionOptions}}" wx:key="templateId" size="mini" bindtap="onSubscribe" data-template="{{item.templateId}}">订阅{{item.events[0]}}</button>
  </view>
  <view class="notice-message" wx:elif="{{subscriptionReady}}">微信提醒暂未开放，站内通知照常。</view>
  <view wx:if="{{selected}}" class="card notice">
    <view class="notice-title">{{selected.title}}</view>
    <view class="notice-content">{{selected.content}}</view>
    <view class="notice-time">{{selected.timeText}}</view>
    <button wx:if="{{selected.conversationId || selected.offerId || selected.goodsId}}" size="mini" bindtap="onOpen">查看详情</button>
  </view>
  <view wx:if="{{error}}" class="notice-message">{{error}}</view>
  <view wx:for="{{list}}" wx:key="_id" class="card notice" bindtap="onRead" data-id="{{item._id}}">
    <view class="notice-title">{{item.title}}<text wx:if="{{!item.read}}" class="new">未读</text></view>
    <view class="notice-content">{{item.content}}</view>
    <view class="notice-time">{{item.timeText}}</view>
  </view>
  <view wx:if="{{loading}}" class="notice-message">加载中</view>
  <view wx:elif="{{!list.length && !error && !selected}}" class="notice-message">暂无消息</view>
</view>
