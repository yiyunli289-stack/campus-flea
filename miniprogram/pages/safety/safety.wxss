.tabs{display:flex;gap:24rpx;padding:20rpx 24rpx;font-size:26rpx}.tabs view{padding:12rpx 0;color:#888}.tabs .on{color:var(--brand);border-bottom:4rpx solid var(--brand)}.record{margin:20rpx 24rpx;padding:24rpx;font-size:27rpx;line-height:1.7}.meta{color:#999;font-size:22rpx;margin-top:10rpx}.action{color:var(--brand);font-size:24rpx;margin-top:14rpx}.empty,.error{text-align:center;margin:60rpx 24rpx;color:#999;font-size:26rpx}.error{color:#a22}
