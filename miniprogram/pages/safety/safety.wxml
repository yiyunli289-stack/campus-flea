<safety-tip/><view class="tabs"><view class="{{tab==='notifications'?'on':''}}" data-tab="notifications" bindtap="onTab">平台通知</view><view class="{{tab==='myReports'?'on':''}}" data-tab="myReports" bindtap="onTab">我的举报</view><view class="{{tab==='blocks'?'on':''}}" data-tab="blocks" bindtap="onTab">拉黑名单</view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="record card" wx:for="{{list}}" wx:key="_id"><block wx:if="{{tab==='notifications'}}"><view>{{item.content}}</view><view class="meta">{{item.timeText}} · {{item.read?'已读':'未读'}}</view><view class="action" wx:if="{{!item.read}}" data-id="{{item._id}}" bindtap="onRead">标为已读</view></block><block wx:elif="{{tab==='myReports'}}"><view>{{item.reason}}</view><view class="meta">{{item.stateText}} · {{item.timeText}}</view><view wx:if="{{item.result}}">{{item.result}}</view></block><block wx:else><view>{{item.targetName || '用户'}}</view><view class="action" data-id="{{item.targetId}}" bindtap="onUnblock">解除拉黑</view></block></view><view class="empty" wx:if="{{!loading&&!list.length&&!error}}">暂无记录</view>
