.page { padding-bottom: 40rpx; }

/* 头部 */
.head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-emoji { font-size: 60rpx; }
.info { flex: 1; }
.name { font-size: 36rpx; font-weight: 700; }
.sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.edit {
  font-size: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
}
.login-btn { background: rgba(255, 255, 255, 0.2); border: none; }

/* 菜单 */
.menu {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx;
  padding: 20rpx 0;
}
.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 0;
}
.m-icon {
  font-size: 48rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand-light);
  border-radius: 24rpx;
}
.m-text { font-size: 24rpx; color: var(--text-2); }

/* 次要列表 */
.sec-list { margin: 0 24rpx; }
.sec-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 8rpx;
  border-top: 1rpx solid var(--border);
}
.sec-item:first-child { border-top: none; }
.sec-icon { font-size: 36rpx; }
.sec-text { flex: 1; font-size: 28rpx; color: var(--text); }
.sec-arrow { color: var(--text-3); font-size: 30rpx; }
