.page { padding: 24rpx 24rpx 60rpx; }

.section { padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 24rpx; }

/* 类目 */
.cat-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.cat-item {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  width: 140rpx; padding: 20rpx 0;
  background: var(--bg); border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.cat-item.on { background: var(--brand-light); border-color: var(--brand); }
.cat-icon { font-size: 44rpx; }
.cat-name { font-size: 22rpx; color: var(--text-2); }
.cat-item.on .cat-name { color: var(--brand); }

/* 图片 */
.img-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.img-item { position: relative; }
.img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: var(--bg); }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 28rpx;
}
.img-add {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  background: var(--bg); color: var(--text-3);
  display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}

/* 交易方式 */
.seg { display: flex; background: var(--bg); border-radius: 16rpx; padding: 6rpx; }
.seg-item {
  flex: 1; text-align: center; font-size: 28rpx; color: var(--text-2);
  padding: 16rpx 0; border-radius: 12rpx;
}
.seg-item.on { background: var(--white); color: var(--brand); font-weight: 600; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.switch-label { font-size: 28rpx; color: var(--text); }

/* 字段 */
.field { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-top: 1rpx solid var(--border); }
.field:first-of-type { border-top: none; }
.label { width: 160rpx; flex-shrink: 0; font-size: 28rpx; color: var(--text); }
.input { flex: 1; font-size: 28rpx; }
.picker-val { font-size: 28rpx; color: var(--text); }
.field-area { align-items: flex-start; }
.textarea { flex: 1; height: 160rpx; font-size: 28rpx; line-height: 1.5; }

.inner-upload { display: flex; gap: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }
.inner-upload .label { padding-top: 20rpx; }

/* 底部 */
.btn-row { display: flex; gap: 24rpx; margin-top: 8rpx; }
.half { flex: 1; }

/* 批量录入入口 */
.batch-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
}
.be-icon { font-size: 44rpx; }
.be-main { flex: 1; }
.be-title { font-size: 30rpx; font-weight: 700; }
.be-sub { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.be-arrow { font-size: 36rpx; opacity: 0.85; }
