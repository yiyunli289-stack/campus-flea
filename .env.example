NODE_ENV=development
PORT=8788
ADMIN_ORIGIN=http://127.0.0.1:8788
# Production: use a random secret of at least 32 characters, provided by the runtime.
AUDIT_SECRET=
CALLBACK_TOKEN=
CALLBACK_AES_KEY=
WECHAT_APPID=
TCB_ENV=
TCB_REGION=ap-shanghai
# Server-only credentials. An environment API Key or Tencent Cloud credentials may be used.
CLOUDBASE_API_KEY=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
# Standalone admin service. Set explicitly on the production host.
ADMIN_HOST=127.0.0.1
# Enable only when this process should run the cloud governance queue.
ADMIN_RUN_WORKER=0
# Bootstrap only; never shipped to browsers or checked into git.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Production archive account should only be allowed to append/read the archive bucket.
ARCHIVE_BUCKET=
ARCHIVE_REGION=
ARCHIVE_SECRET_ID=
ARCHIVE_SECRET_KEY=
