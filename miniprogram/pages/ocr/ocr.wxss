.page { padding: 24rpx 24rpx 60rpx; }

.intro { padding: 8rpx 8rpx 24rpx; }
.intro-title { font-size: 38rpx; font-weight: 700; color: var(--text); }
.intro-sub { font-size: 24rpx; color: var(--text-2); margin-top: 10rpx; line-height: 1.5; }

.section { padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.tip { font-size: 24rpx; color: var(--text-2); line-height: 1.6; margin-bottom: 20rpx; }
.tip b { color: var(--brand); }

.img-list { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.img-item { position: relative; }
.img { width: 190rpx; height: 190rpx; border-radius: 12rpx; background: var(--bg); }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 28rpx;
}
.img-add {
  width: 190rpx; height: 190rpx; border-radius: 12rpx;
  background: var(--bg); color: var(--text-3);
  display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}

.recog-btn { margin-top: 8rpx; }

.hl { color: var(--brand); font-weight: 600; }

.scan-list {
  background: var(--bg); border-radius: 12rpx; padding: 8rpx 22rpx;
  margin-bottom: 20rpx; max-height: 420rpx; overflow-y: auto;
}
.scan-item { padding: 14rpx 0; border-bottom: 1rpx solid var(--border); }
.scan-item:last-child { border-bottom: none; }
.scan-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.scan-isbn { font-size: 26rpx; color: var(--text); font-family: monospace; }
.scan-state { flex-shrink: 0; font-size: 22rpx; color: var(--text-3); }
.scan-title {
  font-size: 24rpx; color: var(--text-2); line-height: 1.4; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.scan-note { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }

.manual { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.manual-input {
  flex: 1; min-width: 0;
  background: var(--bg); border-radius: 12rpx;
  padding: 16rpx 22rpx; font-size: 26rpx;
}
.manual-btn {
  flex-shrink: 0; font-size: 26rpx; color: var(--brand);
  border: 1rpx solid var(--brand); border-radius: 12rpx; padding: 14rpx 28rpx;
}

.foot-tip { text-align: center; font-size: 22rpx; color: var(--text-3); padding: 8rpx 0 8rpx; }
.diag { text-align: center; font-size: 22rpx; color: var(--brand); padding: 12rpx 0 24rpx; text-decoration: underline; }
