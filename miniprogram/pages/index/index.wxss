.page {
  padding: 0 24rpx 40rpx;
}

/* 顶部栏 */
.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}
.campus {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
}
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--white);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  color: var(--text-3);
}
.search-icon { font-size: 28rpx; }
.search-placeholder { font-size: 26rpx; }
.msg-entry { font-size: 40rpx; }

/* 学院书单卡片 */
.booklist-card {
  position: relative;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.bl-title { font-size: 36rpx; font-weight: 700; }
.bl-sub { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.bl-chips {
  margin-top: 24rpx;
  white-space: nowrap;
}
.bl-chip {
  display: inline-block;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
}
.bl-more {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 金刚区 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 12rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}
.grid-icon {
  font-size: 52rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand-light);
  border-radius: 24rpx;
}
.grid-name { font-size: 24rpx; color: var(--text-2); }

/* 分类切换 */
.tabs {
  display: flex;
  gap: 40rpx;
  padding: 8rpx 8rpx 24rpx;
}
.tab {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-2);
  position: relative;
  padding-bottom: 12rpx;
}
.tab.active { color: var(--brand); }
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

/* 商品流 */
.goods {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods-item {
  width: 340rpx;
  margin-bottom: 24rpx;
}
.cover {
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: var(--brand-light);
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
}
.cover-img { width: 100%; height: 100%; }
.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-emoji { font-size: 96rpx; }
.tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.g-body { padding: 20rpx; }
.g-title {
  font-size: 28rpx;
  color: var(--text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  min-height: 78rpx;
}
.g-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 12rpx;
}
.price { font-size: 34rpx; color: var(--accent); font-weight: 700; }
.condition { font-size: 22rpx; color: var(--text-2); }
.g-campus { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

/* 空态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 30rpx; color: var(--text-2); margin-top: 24rpx; }
.empty-sub { font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; }

.footer-tip {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 24rpx 0;
}
