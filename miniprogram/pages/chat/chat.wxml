<view class="page">
  <view class="chat-head">
    <text class="chat-name">{{other.nickName || '聊天'}}</text>
    <view class="chat-contact" bindtap="callContact">{{other.contact ? '复制联系方式' : '成交后可见联系方式'}}</view>
  </view>

  <scroll-view class="msg-list" scroll-y scroll-x="{{false}}" scroll-into-view="{{lastId}}" enhanced show-scrollbar="{{false}}">
    <view class="msg-inner">
      <view wx:for="{{messages}}" wx:key="_id" id="m{{index}}">
        <view class="sys" wx:if="{{item.sys}}">{{item.content}}</view>
        <view class="bubble-row {{item.mine ? 'mine' : ''}}" wx:else>
          <view class="bubble">{{item.content}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <input class="ib-input" placeholder="输入消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" />
    <view class="ib-send" bindtap="send">发送</view>
  </view>
</view>
