.page { padding: 24rpx; }

.conv { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.c-cover {
  width: 96rpx; height: 96rpx; border-radius: 16rpx;
  background: var(--brand-light);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; flex-shrink: 0;
}
.c-img { width: 100%; height: 100%; }
.c-emoji { font-size: 44rpx; }
.c-main { flex: 1; overflow: hidden; }
.c-top { display: flex; align-items: center; justify-content: space-between; }
.c-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.c-time { font-size: 22rpx; color: var(--text-3); }
.c-title { font-size: 24rpx; color: var(--text-2); margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.c-msg { font-size: 24rpx; color: var(--text-3); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.c-badge {
  min-width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  background: var(--accent); color: #fff; font-size: 22rpx; border-radius: 18rpx; padding: 0 8rpx;
}

.login { margin-top: 40rpx; display: inline-block; }
.empty { text-align: center; padding: 80rpx 0; }
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 30rpx; color: var(--text-2); margin-top: 24rpx; }
