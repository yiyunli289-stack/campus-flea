<block wx:if="{{goods}}">
  <!-- 图片轮播 -->
  <swiper wx:if="{{goods.images && goods.images.length}}" class="swiper" indicator-dots circular>
    <swiper-item wx:for="{{goods.images}}" wx:key="*this">
      <image class="slide-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>
  <view wx:else class="swiper slide-ph"><text class="slide-emoji">{{goods.emoji}}</text></view>

  <!-- 主信息 -->
  <view class="card main">
    <view class="price-row">
      <text class="price">¥{{goods.priceText}}</text>
      <text class="price-hint" wx:if="{{goods.tradeType === '竞价'}}">起价</text>
      <text class="tag {{goods.tradeType === '竞价' ? 'tag-bid' : 'tag-fix'}}">{{goods.tradeType === '竞价' ? '买家竞价' : '卖家定价'}}</text>
    </view>
    <view class="title">{{goods.title}}</view>
    <view class="meta-row">
      <text class="meta">{{goods.condition}}</text>
      <text class="meta">📍 {{goods.campus}}</text>
      <text class="meta">{{timeText}}</text>
    </view>
  </view>

  <!-- 图书专属信息 -->
  <view class="card" wx:if="{{isBook}}">
    <view class="card-title">📖 图书信息</view>
    <view class="kv"><text class="k">ISBN</text><text class="v">{{goods.isbn}}</text></view>
    <view class="kv"><text class="k">作者</text><text class="v">{{goods.author}}</text></view>
    <view class="kv"><text class="k">出版社</text><text class="v">{{goods.publisher}}</text></view>
    <view class="kv"><text class="k">版次</text><text class="v">{{goods.edition}}</text></view>
    <view class="kv"><text class="k">适用</text><text class="v">{{goods.college}} · {{goods.course}}</text></view>
    <view class="kv"><text class="k">笔记等级</text><text class="v {{goods.noteClass}}">{{goods.noteLevel}}</text></view>
    <view class="kv"><text class="k">笔记说明</text><text class="v">{{goods.noteDesc}}</text></view>
    <view class="kv"><text class="k">缺损</text><text class="v">{{goods.defects}}</text></view>
    <view class="inner" wx:if="{{goods.innerPhotos && goods.innerPhotos.length}}">
      <text class="k">内页照片</text>
      <view class="inner-imgs">
        <image class="inner-img" wx:for="{{goods.innerPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="card">
    <view class="card-title">描述</view>
    <view class="desc">{{goods.desc}}</view>
  </view>

  <!-- 卖家 -->
  <view class="card seller">
    <view class="s-avatar">
      <image wx:if="{{goods.sellerAvatar}}" class="s-avatar-img" src="{{goods.sellerAvatar}}" />
      <text wx:else>👤</text>
    </view>
    <view class="s-info">
      <view class="s-name">{{goods.sellerName}}</view>
      <view class="s-college">{{goods.sellerCollege}}</view>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="card safety">
    <view class="safety-title">🔒 交易安全提示</view>
    <view class="safety-item">· 请选择公共场所面交，先验货后成交</view>
    <view class="safety-item">· 切勿提前转账、缴纳定金或押金</view>
    <view class="safety-item report" bindtap="onReport">· 发现违规？<text class="report-link">点此举报 ›</text></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{!isMine}}">
    <view class="action-report" bindtap="onReport">⚠️ 举报</view>
    <view class="action-chat" bindtap="onChat">💬 聊一聊</view>
    <view class="btn-brand action-btn" wx:if="{{goods.tradeType === '定价'}}" bindtap="onBuy">按 ¥{{goods.priceText}} 购买</view>
    <view class="btn-brand action-btn" wx:else bindtap="onBid">我要出价</view>
  </view>
  <view class="bar-placeholder" wx:if="{{!isMine}}"></view>
</block>
