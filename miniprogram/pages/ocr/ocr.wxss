.page { padding: 24rpx 24rpx 60rpx; }

.intro { padding: 8rpx 8rpx 24rpx; }
.intro-title { font-size: 38rpx; font-weight: 700; color: var(--text); }
.intro-sub { font-size: 24rpx; color: var(--text-2); margin-top: 10rpx; line-height: 1.5; }

.section { padding: 28rpx; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.tip { font-size: 24rpx; color: var(--text-2); line-height: 1.6; margin-bottom: 20rpx; }
.tip b { color: var(--brand); }

.img-list { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.img-item { position: relative; }
.img { width: 190rpx; height: 190rpx; border-radius: 12rpx; background: var(--bg); }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 28rpx;
}
.img-add {
  width: 190rpx; height: 190rpx; border-radius: 12rpx;
  background: var(--bg); color: var(--text-3);
  display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}

.recog-btn { margin-top: 8rpx; }

.scan-list {
  background: var(--bg); border-radius: 12rpx; padding: 16rpx 22rpx;
  margin-bottom: 20rpx; max-height: 300rpx; overflow-y: auto;
}
.scan-item { font-size: 26rpx; color: var(--text); padding: 6rpx 0; font-family: monospace; }
