.page { padding: 22rpx; }
.notice, .subscription { margin-bottom: 16rpx; padding: 22rpx; }
.notice-title { color: #222; font-size: 30rpx; font-weight: 600; }
.notice-content { color: #444; margin-top: 10rpx; }
.notice-time, .notice-message { color: #767676; margin-top: 14rpx; font-size: 24rpx; }
.notice-message { padding: 20rpx; text-align: center; }
.subscription button, .notice button { margin: 10rpx 12rpx 0 0; }
.new { color: #B4100A; font-size: 22rpx; font-weight: 400; margin-left: 14rpx; }
