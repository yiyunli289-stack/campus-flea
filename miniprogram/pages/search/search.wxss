.page { padding: 0 24rpx 40rpx; }

.search-top { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; }
.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--white);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}
.si-icon { font-size: 28rpx; }
.si-input { flex: 1; font-size: 28rpx; }
.search-btn {
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
}

.cat-row { white-space: nowrap; margin-bottom: 20rpx; }
.cat-chip {
  display: inline-block;
  background: var(--white);
  color: var(--text-2);
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
}
.cat-chip.on { background: var(--brand); color: #fff; }

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.f-item {
  font-size: 26rpx;
  color: var(--text);
  background: var(--bg);
  border-radius: 12rpx;
  padding: 12rpx 22rpx;
}
.f-price { display: flex; align-items: center; gap: 8rpx; }
.price-input {
  width: 130rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  text-align: center;
}
.price-sep { color: var(--text-3); }
.f-reset {
  font-size: 26rpx;
  color: var(--brand);
  padding: 12rpx 8rpx;
}

.result-count { font-size: 24rpx; color: var(--text-3); padding: 8rpx 4rpx 20rpx; }

.goods { display: flex; flex-wrap: wrap; justify-content: space-between; }
.goods-item { width: 340rpx; margin-bottom: 24rpx; }
.cover {
  height: 340rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  background: var(--brand-light);
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
}
.cover-img { width: 100%; height: 100%; }
.cover-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.cover-emoji { font-size: 96rpx; }
.tag {
  position: absolute; top: 16rpx; left: 16rpx;
  background: var(--accent); color: #fff;
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx;
}
.g-body { padding: 20rpx; }
.g-title {
  font-size: 28rpx; color: var(--text);
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; line-height: 1.4; min-height: 78rpx;
}
.g-meta { display: flex; align-items: baseline; gap: 16rpx; margin-top: 12rpx; }
.price { font-size: 34rpx; color: var(--accent); font-weight: 700; }
.condition { font-size: 22rpx; color: var(--text-2); }
.g-campus { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 30rpx; color: var(--text-2); margin-top: 24rpx; }
