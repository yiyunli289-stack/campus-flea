<view class="page">
  <view class="intro">
    <view class="intro-title">批量录入图书</view>
    <view class="intro-sub">拍书脊自动识别，或连续扫 ISBN；识别结果逐本确认后才发布</view>
  </view>

  <!-- 拍照识别 -->
  <view class="section card">
    <view class="sec-title">📷 拍照识别（最多 3 张）</view>
    <view class="tip">拍摄技巧：把书<b>平放、书脊横向</b>对齐，文字清晰、避免反光和遮挡，识别率最高。</view>
    <view class="img-list">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="img" src="{{item}}" mode="aspectFill" />
        <view class="img-del" catchtap="removeImage" data-i="{{index}}">×</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 3}}" bindtap="chooseImages">＋</view>
    </view>
    <view class="btn-brand recog-btn" bindtap="recognize">{{processing ? '识别中…' : '开始识别'}}</view>
  </view>

  <!-- 扫码 -->
  <view class="section card">
    <view class="sec-title">🔖 ISBN 连续扫码</view>
    <view class="tip">教材背面都有条码。扫到 ISBN 会<text class="hl">自动查书名、作者、出版社和封面</text>，逐本扫即可批量加。</view>
    <view class="scan-list" wx:if="{{scanList.length}}">
      <view class="scan-item" wx:for="{{scanList}}" wx:key="key">
        <view class="scan-line">
          <text class="scan-isbn">{{index + 1}}. {{item.isbn}}</text>
          <text class="scan-state" wx:if="{{item.loading}}">查询中…</text>
        </view>
        <view class="scan-title" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="scan-note" wx:elif="{{!item.loading}}">{{item.note || '未收录，可稍后手填书名'}}</view>
      </view>
    </view>
    <view class="manual">
      <input
        class="manual-input"
        placeholder="也可手动输入 10/13 位 ISBN"
        value="{{manualIsbn}}"
        bindinput="onManualInput"
        confirm-type="search"
        bindconfirm="manualLookup"
      />
      <view class="manual-btn" bindtap="manualLookup">查询</view>
    </view>
    <view class="btn-brand recog-btn" bindtap="scanIsbn">开始扫码</view>
  </view>

  <view class="foot-tip">识别结果都会先进入确认页，逐本核对后才发布。</view>
  <view class="diag" bindtap="onDiag">拍照识别用不了？点这里检测</view>
</view>
