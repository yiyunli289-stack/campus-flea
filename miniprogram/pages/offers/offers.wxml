<view class="page">
  <view wx:if="{{subscriptionOptions.length}}">
    <button wx:for="{{subscriptionOptions}}" wx:key="templateId" size="mini" bindtap="onSubscribe" data-template="{{item.templateId}}">订阅{{item.events[0]}}</button>
  </view>
  <view class="tabs">
    <view class="tab {{tab === 'received' ? 'on' : ''}}" bindtap="onTab" data-tab="received">收到的报价</view>
    <view class="tab {{tab === 'sent' ? 'on' : ''}}" bindtap="onTab" data-tab="sent">我发出的</view>
  </view>

  <!-- 收到的报价 -->
  <block wx:if="{{tab === 'received'}}">
    <view class="offer card" wx:for="{{received}}" wx:key="_id">
      <view class="o-top">
        <view class="o-user">{{item.buyerName}}<text class="o-college" wx:if="{{item.buyerCollege}}"> · {{item.buyerCollege}}</text></view>
        <view class="o-price">¥{{item.priceText}}</view>
      </view>
      <view class="o-goods">商品：{{item.goodsTitle}}</view>
      <view class="o-msg" wx:if="{{item.message}}">留言：{{item.message}}</view>
      <view class="o-time">{{item.timeText}}</view>
      <view class="o-status st-{{item.status}}">{{item.statusText}}</view>
      <view class="o-contact" wx:if="{{item.status === 'accepted' && item.buyerContact}}">买家联系：{{item.buyerContact}}</view>
      <view class="o-actions">
        <view class="o-btn primary" wx:if="{{item.status === 'pending'}}" bindtap="onAccept" data-id="{{item._id}}">接受此报价</view>
        <view class="o-btn" wx:if="{{item.status === 'pending'}}" bindtap="onOfferAction" data-action="decline" data-id="{{item._id}}">拒绝</view>
        <view class="o-btn" wx:if="{{item.canRestore}}" bindtap="onOfferAction" data-action="restoreListing" data-id="{{item._id}}">恢复在售</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onOfferAction" data-action="cancelLock" data-id="{{item._id}}">取消锁定</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onOfferAction" data-action="confirmMeetup" data-id="{{item._id}}">确认面交</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onChat" data-goods-id="{{item.goodsId}}">去聊天</view>
      </view>
    </view>
  </block>

  <!-- 我发出的报价 -->
  <block wx:if="{{tab === 'sent'}}">
    <view class="offer card" wx:for="{{sent}}" wx:key="_id">
      <view class="o-top">
        <view class="o-goods">商品：{{item.goodsTitle}}</view>
        <view class="o-price">¥{{item.priceText}}</view>
      </view>
      <view class="o-time">{{item.timeText}}</view>
      <view class="o-status st-{{item.status}}">{{item.statusText}}</view>
      <view class="o-contact" wx:if="{{item.status === 'accepted' && item.sellerContact}}">卖家联系：{{item.sellerContact}}</view>
      <view class="o-actions">
        <view class="o-btn" wx:if="{{item.status === 'pending'}}" bindtap="onCancel" data-id="{{item._id}}">撤回申请</view>
        <view class="o-btn" wx:if="{{item.status === 'pending' && item.tradeType === '竞价'}}" bindtap="onOfferAction" data-action="update" data-id="{{item._id}}">修改报价</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onOfferAction" data-action="cancelLock" data-id="{{item._id}}">取消锁定</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onOfferAction" data-action="confirmMeetup" data-id="{{item._id}}">确认面交</view>
        <view class="o-btn" wx:if="{{item.canTrade}}" bindtap="onChat" data-goods-id="{{item.goodsId}}">去聊天</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!received.length && !sent.length}}">
    <view class="empty-emoji">💰</view>
    <view class="empty-text">暂无报价</view>
  </view>
</view>
